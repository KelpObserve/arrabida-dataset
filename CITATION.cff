cff-version: 1.2.0
message: "If you use this script, cite the dataset it builds and this repository as below."
type: software
title: "KelpObserve Sesimbra 2026: dataset companion scripts"
version: "1.0.0"
license: Apache-2.0
repository-code: "https://github.com/KelpObserve/arrabida-dataset"
abstract: "Companion scripts of the KelpObserve Sesimbra 2026 dataset (diver quadrat surveys of the kelp Saccorhiza polyschides, sonde casts, quadrat positions and dive tracks): derivation of the tidy tables from the files delivered by CCMAR, packing of the quadrat photographs, position check against lidar bathymetry, summary table and overview map. Each script reproduces the corresponding file of release 1.0.0 byte for byte."
authors:
  - family-names: "Rusu"
    given-names: "Andrei"
    affiliation: "Pine View Software AS (Pineview), Norway"
    orcid: "https://orcid.org/0009-0000-1219-4816"
keywords:
  - "kelp"
  - "Saccorhiza polyschides"
  - "quadrat survey"
  - "multiparameter sonde"
  - "data processing"
  - "tidy data"
  - "Sesimbra"
  - "Portugal"
  - "AQUASERV"
  - "KelpObserve"
references:
  - type: data
    title: "KelpObserve Sesimbra 2026: diver quadrat surveys of the kelp Saccorhiza polyschides and water-column sonde profiles, Arrábida coast, Portugal"
